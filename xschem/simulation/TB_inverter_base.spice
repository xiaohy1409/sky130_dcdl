** sch_path: /home/xiaohi/Projects/sky130_dcdl/xschem/schematic/SCI_DCDL/TG_SCI/TB_inverter_base.sch
**.subckt TB_inverter_base
x1 net1 IN OUT 0 inverter_base
V2 IN 0 PULSE(0 1.8 1n 50p 50p 2n 4n)
V7 net1 0 1.8
**** begin user architecture code

.tran 1p 25n 0 1p

.control
save v(IN) v(OUT)
run

meas tran t_rise TRIG v(IN) VAL=0.9 RISE=2 TARG v(OUT) VAL=0.9 RISE=2
meas tran t_fall TRIG v(IN) VAL=0.9 FALL=2 TARG v(OUT) VAL=0.9 FALL=2

let t_pd = (t_rise + t_fall)/2
let t_pd_ps = t_pd*1e12

print t_pd_ps
.endc



