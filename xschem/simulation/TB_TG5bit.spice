** sch_path: /home/xiaohi/Projects/sky130_dcdl/xschem/schematic/SCI_DCDL/TG_SCI/TB_TG5bit.sch
**.subckt TB_TG5bit
V2 IN 0 PULSE(0 1.8 1n 50p 50p 2n 4n)
V3 net1 0 1.8
V1 net2 0 1.8
V4 net3 0 1.8
V5 net4 0 1.8
V6 net5 0 1.8
V7 net6 0 1.8
x1 net6 IN OUT 0 net3 net5 net4 net2 net1 SCI_TG_5bit
**** begin user architecture code


.option rshunt=1e12
.tran 1p 25n 0 1p

.control

* Save signals for measurement
save v(IN) v(OUT)

* Output file
echo code t_rise_ps t_fall_ps t_pd_ps > /home/xiaohi/Projects/sky130_dcdl/results/csv/sci_tg_5bit.dat

* Sweep 32 control codes
foreach b4 0 1
 foreach b3 0 1
  foreach b2 0 1
   foreach b1 0 1
    foreach b0 0 1

     * Calculate control voltages
     let v0 = 1.8 * $b0
     let v1 = 1.8 * $b1
     let v2 = 1.8 * $b2
     let v3 = 1.8 * $b3
     let v4 = 1.8 * $b4

     * Update voltage sources
     alter V3 dc = $&v0
     alter V1 dc = $&v1
     alter V4 dc = $&v2
     alter V5 dc = $&v3
     alter V6 dc = $&v4

     * Run transient
     run

     * Propagation delay: two inverters
     meas tran t_rise TRIG v(IN) VAL=0.9 RISE=2 TARG v(OUT) VAL=0.9 RISE=2

     meas tran t_fall TRIG v(IN) VAL=0.9 FALL=2 TARG v(OUT) VAL=0.9 FALL=2

     * Calculate delay in ps
     let code = 16*$b4 + 8*$b3 + 4*$b2 + 2*$b1 + $b0

     let rise_ps = t_rise * 1e12
     let fall_ps = t_fall * 1e12
     let pd_ps = (rise_ps + fall_ps)/2

     * Write results
     echo $&code $&rise_ps $&fall_ps $&pd_ps >> /home/xiaohi/Projects/sky130_dcdl/results/csv/sci_tg_5bit.dat

    end
   end
  end
 end
end

echo SCI TG 5-bit sweep completed
.endc



** opencircuitdesign pdks install
.lib /home/xiaohi/.ciel/ciel/sky130/versions/1689ac3f2dc763876eaf967227c7dfe831b031ae/sky130A/libs.tech/combined/sky130.lib.spice tt

**** end user architecture code
**.ends

