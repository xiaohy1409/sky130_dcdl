** sch_path: /home/xiaohi/Projects/sky130_dcdl/xschem/schematic/TB_SCI_MOS.sch
**.subckt TB_SCI_MOS
x1 net1 IN OUT 0 net6 net5 net4 net3 net2 SCI_1bit
V1 net2 0 0
V2 net3 0 0
V3 net4 0 0
V4 net5 0 0
V5 net6 0 0
V6 IN 0 PULSE(0 1.8 1n 50p 50p 2n 4n)
V7 net1 0 1.8
**** begin user architecture code

** opencircuitdesign pdks install
.lib /home/xiaohi/.ciel/ciel/sky130/versions/1689ac3f2dc763876eaf967227c7dfe831b031ae/sky130A/libs.tech/combined/sky130.lib.spice tt



.option rshunt=1e12
.tran 2p 25n

.control
save v(IN) v(OUT)

* Output file
echo code t_rise_ps t_fall_ps t_pd_ps > /home/xiaohi/Projects/sky130_dcdl/results/csv/sci5_delay.dat

* Sweep 5-bit: 00000 -> 11111
foreach b4 0 1
 foreach b3 0 1
  foreach b2 0 1
   foreach b1 0 1
    foreach b0 0 1

     * Convert bits to voltage
     let v0 = 1.8 * $b0
     let v1 = 1.8 * $b1
     let v2 = 1.8 * $b2
     let v3 = 1.8 * $b3
     let v4 = 1.8 * $b4

     * Set control voltage
     alter V1 $&v0
     alter V2 $&v1
     alter V3 $&v2
     alter V4 $&v3
     alter V5 $&v4

     * Run transient simulation
     run

     * Measure propagation delay
     meas tran t_rise TRIG v(IN) VAL=0.9 RISE=2 TARG v(OUT) VAL=0.9 RISE=2
     meas tran t_fall TRIG v(IN) VAL=0.9 FALL=2 TARG v(OUT) VAL=0.9 FALL=2

     * Calculate code and delay in ps
     let code = 16 * $b4 + 8 * $b3 + 4 * $b2 + 2 * $b1 + $b0
     let rise_ps = t_rise * 1e12
     let fall_ps = t_fall * 1e12
     let pd_ps = (rise_ps + fall_ps)/2

     * Append result to file
     echo $&code $&rise_ps $&fall_ps $&pd_ps >> /home/xiaohi/Projects/sky130_dcdl/results/csv/sci5_delay.dat

    end
   end
  end
 end
end

echo Sweep completed: 32 codes
.endc


**** end user architecture code
**.ends

